.env
__pycache__/
*.pyc
.venv/
dist/
*.egg-info/
# npm wrapper: `npm pack` output; it has no dependencies, so node_modules only
# appears by accident.
npm/node_modules/
npm/*.tgz

# Data (managed via GitHub Releases, not committed)
.data/

# Logs
*.log

# Local tool artifacts (per-machine, not part of the project)
.codex/
.idea/
cleanup-evidence/
graphify-out/
.env.*

# Vaults live in their own repositories. A vault copied or cloned here never
# enters this repository's history.
/vault/

# Notes written by background agents during a session: generated, per-machine.
.claude/agent-memory/
# The same file at the repository root, written when this checkout is itself
# onboarded onto a tool that keeps per-machine hooks (graphify's, for one).
.claude/settings.local.json
# Snapshots locales de ChromaDB, no reproducibles desde el repositorio.
.data.bak-*/
# Platform code graph: merged-graph.json is 132.3 MiB (138.7 MB) and is regenerated
# from the per-repository graphs by scripts/build-platform-graph.sh. Per-machine
# artifact, never repository history.
platform-graph/

# Coverage / test artifacts (regenerated by the ring-1 pipeline)
build/
.coverage
*.bak

# macOS finder metadata
.DS_Store

# Throwaway fixtures of the dockerized lab (lab/seed.sh builds them).
lab/.work/
