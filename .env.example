# Secrets only — static config lives in config.json

OPENAI_API_KEY=
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=

# ---------------------------------------------------------------------------
# HTTP transport (only required when running the server in remote mode,
# e.g. inside Dokploy). Leave blank to keep the default stdio transport.
# ---------------------------------------------------------------------------

# Set to "http" to expose the streamable-http transport on 0.0.0.0:8000.
# Default is "stdio" (local dev, single client).
MCP_TRANSPORT=

# Bearer token required by every /mcp request. Generate with:
#   openssl rand -hex 32
# Mandatory when MCP_TRANSPORT=http.
MCP_API_KEY=

# Shared secret used to validate the Bitbucket webhook signature
# (X-Hub-Signature; X-Hub-Signature-256 is accepted too). Generate with:
#   openssl rand -hex 32
# Optional — if unset, the /webhook/reindex endpoint only accepts the
# manual Bearer flow (Authorization: Bearer $MCP_API_KEY).
MCP_WEBHOOK_SECRET=

# HTTP host/port/path (defaults: 0.0.0.0, 8000, /mcp)
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=8000
# MCP_HTTP_PATH=/mcp

# The vault lives in its own repository.
# Point VAULT_PATH at a clone of it, or leave it unset and declare the vaults
# in $XDG_CONFIG_HOME/knowledge/vaults.yaml (or KNOWLEDGE_VAULTS). With none of
# the three, the server refuses to start with E_VAULT_PATH_MISSING.
# VAULT_PATH=/path/to/vault-checkout
# CHROMA_PERSIST_DIR=/path/to/chroma

# ---------------------------------------------------------------------------
# Host paths mounted into the containers
# ---------------------------------------------------------------------------

# Host directory that holds the sibling project checkouts. It is bind-mounted
# read-only at the same path inside the knowledge container, so tooling that
# resolves sibling repositories keeps working there. Optional: when unset,
# /opt/knowledge/projects is mounted and is empty unless it exists on the host
# — the MCP server itself does not use it.
# HOST_PROJECTS_ROOT=/home/deploy/projects

# Build context of the memory fork, used by the memory-cloud service.
# Defaults to ../../../memory relative to infra/.
# MEMORY_REPO=/home/deploy/projects/memory
