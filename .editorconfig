root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[*.toml]
indent_size = 4

[*.md]
# Trailing spaces are hard line breaks in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Fixtures and recorded goldens are byte-exact test data (some are CRLF or
# have no final newline on purpose); editors must not rewrite them.
[{tests/fixtures/**,tests/golden/**}]
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
charset = unset
